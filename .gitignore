# Generated report output, all of it reproducible by the command that writes it:
# `reports/mutation/` (npm run test:mutation), `reports/load/` (k6 handleSummary),
# `site/` (node scripts/build-report-site.mjs).
reports/*
.stryker-tmp/
site/

# That includes reports/history/, where `npm run report:metrics` writes by
# default. The real history is `metrics.jsonl` on the `metrics` branch, written
# by CI — see scripts/record-metrics.mjs.
