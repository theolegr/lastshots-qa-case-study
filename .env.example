# Copy to .env and fill in with your own Supabase project's values.
#
# Both are safe to expose: they are compiled into the frontend bundle and are
# visible to anyone using the deployed app. The service_role key is deliberately
# absent — the E2E suite runs under real Row Level Security with no bypass, so
# nothing in this repo ever needs it.
#
# Find these under Project Settings -> API in the Supabase dashboard.

VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"

# Used by the Supabase CLI only (migrations, type generation). Must match the
# project ref in VITE_SUPABASE_URL and in supabase/config.toml.
VITE_SUPABASE_PROJECT_ID="<project-ref>"
